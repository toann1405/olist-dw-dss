{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPI",
      "queryLines": [
        "SELECT (SELECT SUM(CASE WHEN seller_ship_late_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN seller_ship_late_flag IS NOT NULL THEN 1.0 ELSE 0 END) FROM fact_order_item WHERE seller_key <> -1) AS late_ship_rate, (SELECT SUM(CASE WHEN negative_review_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN negative_review_flag IS NOT NULL THEN 1.0 ELSE 0 END) FROM fact_order) AS negative_review_rate "
      ]
    },
    {
      "name": "ds_region",
      "displayName": "Late ship by region",
      "queryLines": [
        "SELECT region_name, SUM(CASE WHEN seller_ship_late_flag = 1 THEN 1 ELSE 0 END) AS late_items, SUM(CASE WHEN seller_ship_late_flag IS NOT NULL THEN 1 ELSE 0 END) AS eligible_items, SUM(CASE WHEN seller_ship_late_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN seller_ship_late_flag IS NOT NULL THEN 1.0 ELSE 0 END) AS late_ship_rate FROM fact_order_item i INNER JOIN dim_seller s ON i.seller_key = s.seller_key WHERE i.seller_key <> -1 GROUP BY region_name ORDER BY region_name "
      ]
    },
    {
      "name": "ds_rollup",
      "displayName": "Roll-up late handoff",
      "queryLines": [
        "WITH items AS (SELECT s.region_name, s.state_code, s.city_name, i.seller_ship_late_flag FROM fact_order_item i INNER JOIN dim_seller s ON i.seller_key = s.seller_key WHERE i.seller_key <> -1) SELECT region_name, state_code, city_name, CASE WHEN GROUPING(region_name) = 1 THEN 'all' WHEN GROUPING(state_code) = 1 THEN 'region' WHEN GROUPING(city_name) = 1 THEN 'state' ELSE 'city' END AS rollup_level, SUM(CASE WHEN seller_ship_late_flag = 1 THEN 1 ELSE 0 END) AS late_items, SUM(CASE WHEN seller_ship_late_flag IS NOT NULL THEN 1 ELSE 0 END) AS eligible_items, SUM(CASE WHEN seller_ship_late_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN seller_ship_late_flag IS NOT NULL THEN 1.0 ELSE NULL END) AS late_ship_rate FROM items GROUP BY ROLLUP (region_name, state_code, city_name) ORDER BY region_name, state_code, city_name "
      ]
    },
    {
      "name": "ds_drill",
      "displayName": "Negative review by date",
      "queryLines": [
        "SELECT d.year, d.quarter, d.month, d.day_of_month, d.full_date, SUM(CASE WHEN o.negative_review_flag = 1 THEN 1 ELSE 0 END) AS negative_orders, SUM(CASE WHEN o.negative_review_flag IS NOT NULL THEN 1 ELSE 0 END) AS reviewed_orders, SUM(CASE WHEN o.negative_review_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN o.negative_review_flag IS NOT NULL THEN 1.0 ELSE NULL END) AS negative_review_rate FROM fact_order o INNER JOIN dim_date d ON o.purchase_date_key = d.date_key WHERE d.date_key <> -1 GROUP BY d.year, d.quarter, d.month, d.day_of_month, d.full_date ORDER BY d.full_date "
      ]
    },
    {
      "name": "ds_slice",
      "displayName": "Late delivery by seller in one category",
      "queryLines": [
        "WITH orders_in_group AS (SELECT DISTINCT i.order_id, i.seller_key, i.late_delivery_flag FROM fact_order_item i INNER JOIN dim_product p ON i.product_key = p.product_key WHERE p.category_group = 'electronics_it_telephony' AND i.seller_key <> -1) SELECT s.seller_id, s.state_code, COUNT(DISTINCT CASE WHEN g.late_delivery_flag = 1 THEN g.order_id END) AS late_orders, COUNT(DISTINCT CASE WHEN g.late_delivery_flag IS NOT NULL THEN g.order_id END) AS eligible_orders, try_divide(COUNT(DISTINCT CASE WHEN g.late_delivery_flag = 1 THEN g.order_id END), COUNT(DISTINCT CASE WHEN g.late_delivery_flag IS NOT NULL THEN g.order_id END)) AS late_delivery_rate FROM orders_in_group g INNER JOIN dim_seller s ON g.seller_key = s.seller_key GROUP BY s.seller_id, s.state_code ORDER BY late_delivery_rate DESC, eligible_orders DESC "
      ]
    },
    {
      "name": "ds_dice",
      "displayName": "Norte Nordeste bulky 2018 H1",
      "queryLines": [
        "WITH region_orders AS (SELECT o.order_id FROM fact_order o INNER JOIN dim_date d ON o.purchase_date_key = d.date_key WHERE o.customer_region_name IN ('Norte', 'Nordeste') AND d.year = 2018 AND d.quarter IN (1, 2)), bulky_sellers AS (SELECT DISTINCT i.order_id, i.seller_key FROM fact_order_item i INNER JOIN region_orders r ON i.order_id = r.order_id INNER JOIN dim_product p ON i.product_key = p.product_key WHERE p.size_band = 'bulky' AND i.seller_key <> -1) SELECT s.state_code, COUNT(DISTINCT CASE WHEN o.late_flag = 1 THEN b.order_id END) AS late_orders, COUNT(DISTINCT CASE WHEN o.late_flag IS NOT NULL THEN b.order_id END) AS late_eligible_orders, COUNT(DISTINCT CASE WHEN o.late_flag = 1 THEN b.order_id END) / COUNT(DISTINCT CASE WHEN o.late_flag IS NOT NULL THEN b.order_id END) AS late_delivery_rate, COUNT(DISTINCT CASE WHEN o.n_sellers = 1 AND o.shared_review_type IN ('none', 'same_seller') AND o.negative_review_flag = 1 THEN b.order_id END) AS negative_review_orders, COUNT(DISTINCT CASE WHEN o.n_sellers = 1 AND o.shared_review_type IN ('none', 'same_seller') AND o.negative_review_flag IS NOT NULL THEN b.order_id END) AS review_eligible_orders, COUNT(DISTINCT CASE WHEN o.n_sellers = 1 AND o.shared_review_type IN ('none', 'same_seller') AND o.negative_review_flag = 1 THEN b.order_id END) / COUNT(DISTINCT CASE WHEN o.n_sellers = 1 AND o.shared_review_type IN ('none', 'same_seller') AND o.negative_review_flag IS NOT NULL THEN b.order_id END) AS seller_negative_review_rate FROM bulky_sellers b INNER JOIN fact_order o ON b.order_id = o.order_id INNER JOIN dim_seller s ON b.seller_key = s.seller_key GROUP BY s.state_code ORDER BY s.state_code "
      ]
    },
    {
      "name": "ds_pivot",
      "displayName": "Category by quarter late handoff",
      "queryLines": [
        "WITH rates AS (SELECT p.category_group, d.quarter, SUM(CASE WHEN i.seller_ship_late_flag = 1 THEN 1 ELSE 0 END) AS late_items, SUM(CASE WHEN i.seller_ship_late_flag IS NOT NULL THEN 1 ELSE 0 END) AS eligible_items FROM fact_order_item i INNER JOIN dim_product p ON i.product_key = p.product_key INNER JOIN dim_date d ON i.purchase_date_key = d.date_key WHERE i.seller_key <> -1 AND p.product_key <> -1 AND d.date_key <> -1 GROUP BY p.category_group, d.quarter), long_rates AS (SELECT category_group, quarter, CASE WHEN eligible_items > 0 THEN late_items / eligible_items END AS late_ship_rate FROM rates) SELECT * FROM long_rates PIVOT (FIRST(late_ship_rate) FOR quarter IN (1 AS q1, 2 AS q2, 3 AS q3, 4 AS q4)) ORDER BY category_group "
      ]
    },
    {
      "name": "ds_seller",
      "displayName": "Seller profile",
      "queryLines": [
        "SELECT s.seller_id, s.region_name, s.state_code, s.city_name, SUM(CASE WHEN i.seller_ship_late_flag = 1 THEN 1 ELSE 0 END) AS late_ship_items, SUM(CASE WHEN i.seller_ship_late_flag IS NOT NULL THEN 1 ELSE 0 END) AS late_ship_eligible, SUM(CASE WHEN i.seller_ship_late_flag = 1 THEN 1 ELSE 0 END) / SUM(CASE WHEN i.seller_ship_late_flag IS NOT NULL THEN 1.0 ELSE NULL END) AS late_ship_rate, COUNT(DISTINCT CASE WHEN i.late_delivery_flag = 1 THEN i.order_id END) AS late_delivery_orders, COUNT(DISTINCT CASE WHEN i.late_delivery_flag IS NOT NULL THEN i.order_id END) AS late_delivery_eligible, try_divide(COUNT(DISTINCT CASE WHEN i.late_delivery_flag = 1 THEN i.order_id END), COUNT(DISTINCT CASE WHEN i.late_delivery_flag IS NOT NULL THEN i.order_id END)) AS late_delivery_rate FROM fact_order_item i INNER JOIN dim_seller s ON i.seller_key = s.seller_key WHERE i.seller_key <> -1 GROUP BY s.seller_id, s.region_name, s.state_code, s.city_name ORDER BY late_ship_rate DESC "
      ]
    }
  ],
