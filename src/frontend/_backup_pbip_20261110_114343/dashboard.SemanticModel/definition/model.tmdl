model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_order_item","fact_order","fact_seller_monthly","dim_date","dim_month","dim_seller","dim_product","_Measures"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table fact_order_item
ref table fact_order
ref table fact_seller_monthly
ref table dim_date
ref table dim_month
ref table dim_seller
ref table dim_product
ref table _Measures

ref cultureInfo en-US

