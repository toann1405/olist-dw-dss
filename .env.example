# Copy to .env and fill in real values. Never commit .env.
# DATABRICKS_TOKEN must stay empty in this example. Put the real token only in .env.

# Databricks SQL warehouse (local Python / Streamlit). Connectivity is unverified until spike S2.
# Optional on Databricks Apps. Priority: st.secrets, then the environment, then this file if it exists.
# Host: DATABRICKS_SERVER_HOSTNAME, or DATABRICKS_HOST when that name is empty in the same source.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Unity Catalog. Recorded by spike S1 on 13/10/2026.
UC_CATALOG=olist_catalog
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold
DSS_SCHEMA=dss

# Data locations (relative to repo root)
RAW_DATA_DIR=data/raw
EXTERNAL_DATA_DIR=data/external
SAMPLE_DATA_DIR=data/sample

# Not used by Phase 3 warehouse ETL (src/etl/ is Databricks-only).
# Reserved for a later R46 local rerun on data/sample (S6, Phase 6, Phase 7).
USE_SAMPLE=0

