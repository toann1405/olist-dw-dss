# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (staging + DW live in the same database, separate schemas)
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist_dw
PG_USER=olist
PG_PASSWORD=change_me

# Schemas
STAGING_SCHEMA=staging
DW_SCHEMA=dw
DSS_SCHEMA=dss

# Data locations (relative to repo root)
RAW_DATA_DIR=data/raw
EXTERNAL_DATA_DIR=data/external
SAMPLE_DATA_DIR=data/sample

# Set to 1 to run ETL on data/sample instead of data/raw (quick demo)
USE_SAMPLE=0

# Kaggle API (only needed for automatic download; alternatively use ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
