# Copy to .env and fill in real values. Never commit .env.
# DATABRICKS_TOKEN must stay empty in this example. Put the real token only in .env.

# Databricks SQL warehouse (local Python / Streamlit). Connectivity is unverified until spike S2.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Unity Catalog. Leave UC_CATALOG empty until spike S1. Do not guess a real catalog name.
UC_CATALOG=
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold
DSS_SCHEMA=dss

# Data locations (relative to repo root)
RAW_DATA_DIR=data/raw
EXTERNAL_DATA_DIR=data/external
SAMPLE_DATA_DIR=data/sample

# Set to 1 to run ETL on data/sample instead of data/raw (quick demo / local rerun)
USE_SAMPLE=0

# Kaggle API (only needed for automatic download; alternatively use ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
